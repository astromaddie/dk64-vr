+//
+// RT64
+//
+// VR hidden-area mask (rt64_vr.h, hiddenMesh): the headset's hidden triangles, already in
+// normalized device coordinates, drawn at the near plane before the eye's scene so that every
+// depth-tested draw skips those pixels. Compiled only with RT64_VR.
+//
+
+void VSMain(in float2 iPosition : POSITION, out float4 oPosition : SV_Position) {
+    oPosition = float4(iPosition, 0.0f, 1.0f);
+}
diff --git a/src/shared/rt64_projection_fog.h b/src/shared/rt64_projection_fog.h
new file mode 100644
index 0000000..664e9d0
--- /dev/null
+++ b/src/shared/rt64_projection_fog.h
@@ -0,0 +1,50 @@
+// The same depth conversion is used by the projection processor, RSP shader and host tests.
+#pragma once
+
+#ifdef __cplusplus
+#include <cmath>
+namespace RT64 {
+    struct ProjectionFogRemap { float a = 1.0f, b = 0.0f; };
+
+    // Row-major standard perspective: z/w = A + B/d, with A=m22/m23, B=-m32/m23.
+    // Coefficients are computed in double from the actual interpolated float matrices.
+    inline ProjectionFogRemap projectionFogRemap(const float *game, const float *eye) {
+        if ((game[10] == eye[10]) && (game[11] == eye[11]) && (game[14] == eye[14]) && (game[15] == eye[15])) {
+            return {};
+        }
+        if ((game[15] != 0.0f) || (eye[15] != 0.0f) || (std::fabs(game[11]) < 1e-12f) || (std::fabs(eye[11]) < 1e-12f)) {
+            return {};
+        }
+        const double ga = double(game[10]) / game[11], gb = -double(game[14]) / game[11];
+        const double ea = double(eye[10]) / eye[11], eb = -double(eye[14]) / eye[11];
+        if (std::fabs(eb) < 1e-12) return {};
+        const double a = gb / eb;
+        return { float(a), float(ga - a * ea) };
+    }
+
+    inline ProjectionFogRemap projectionScreenRemap(float a, float b, float viewportScale, float viewportTranslate) {
+        return { a, float(double(viewportScale) * b + (1.0 - double(a)) * viewportTranslate) };
+    }
+
+    inline
+#endif
+    float projectionFogZ(float z, float w, float a, float b) {
+        // Remap BEFORE max(z,0)/w: newly visible geometry inside the game's near must retain
+        // the game's zero-clamped fog, not the fog of the eye near plane. Preserve identity bits.
+        return ((a == 1.0f) && (b == 0.0f)) ? z : (z * a + w * b);
+    }
+#ifdef __cplusplus
+    inline
+#endif
+    float projectionEyeDepth(float gameDepth, float a, float b) {
+        return ((a == 1.0f) && (b == 0.0f)) ? gameDepth : ((gameDepth - b) / a);
+    }
+#ifdef __cplusplus
+    inline
+#endif
+    float projectionGameDepth(float eyeDepth, float a, float b) {
+        return ((a == 1.0f) && (b == 0.0f)) ? eyeDepth : (eyeDepth * a + b);
+    }
+#ifdef __cplusplus
+}
+#endif
