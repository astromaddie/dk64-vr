diff --git a/src/shared/rt64_vr_billboard.h b/src/shared/rt64_vr_billboard.h
new file mode 100644
index 0000000..da6cfc8
--- /dev/null
+++ b/src/shared/rt64_vr_billboard.h
@@ -0,0 +1,166 @@
+// Camera-facing billboards in VR eye passes. A game builds a billboard's model matrix from its own
+// camera, so in the headset it faces the flat game camera and turns edge-on away from the centre of
+// the game's view. The eye pass rebuilds the rotation of the model matrices the host names (by
+// matrix group) to face a viewpoint instead. Shared by the transform processor and host tests.
+#pragma once
+
+#include <cmath>
+#include <cstdint>
+
+namespace RT64 {
+    enum class VrBillboardMode : uint32_t {
+        None = 0,
+        // Turns about the world's up axis (+Y) only and stays upright: upright sprites (props,
+        // collectibles, trees).
+        Cylindrical = 1,
+        // Faces the viewpoint completely: particles and effects.
+        Spherical = 2,
+        // As the game built it: cylindrical when the game kept it upright (no pitch), else
+        // spherical.
+        Matching = 3
+    };
+
+    // Model matrices in matrix groups firstId..lastId (inclusive) are billboards of this mode.
+    struct VrBillboardGroup {
+        uint32_t firstId = 0;
+        uint32_t lastId = 0;
+        VrBillboardMode mode = VrBillboardMode::None;
+    };
+
+    inline VrBillboardMode vrBillboardMode(const VrBillboardGroup *groups, uint32_t groupCount, uint32_t matrixId) {
+        for (uint32_t i = 0; i < groupCount; i++) {
+            if ((matrixId >= groups[i].firstId) && (matrixId <= groups[i].lastId)) {
+                return groups[i].mode;
+            }
+        }
+
+        return VrBillboardMode::None;
+    }
+
+    // m: a model (world) matrix, row-major 4x4 in RT64's row-vector convention: rows 0-2 are the
+    // local X, Y, Z axes in world space, row 3 the position. A billboard is a quad in its local XY
+    // plane whose local +Z the game pointed at its camera, its local X kept level (yaw and pitch,
+    // no roll).
+    //
+    // The game's camera basis C is recovered from the matrix itself (Z = the row-2 direction,
+    // X = level, Y = Z x X), so what the game added on top of it, L = R * C^T (the sprite's own
+    // roll, scale and mirroring), is kept, and only C is replaced by a basis facing `viewpoint`:
+    // R' = L * E. It turns about `pivot` (local coordinates; the origin when null): that point
+    // keeps its world position. Games often turn a billboard about a point away from its origin
+    // (a map model's billboard nodes: the node's centre in map coordinates).
+    // A flat billboard (row 2 zero: a zero Z scale) takes Z from row 0 x row 1, on the side of
+    // `gameViewpoint` (the game camera's position; `viewpoint` when null).
+    // Returns false and leaves m unchanged when the matrix or the viewpoint is degenerate.
+    inline bool vrFaceBillboard(float m[16], const float viewpoint[3], VrBillboardMode mode, const float *gameViewpoint = nullptr, const float *pivot = nullptr) {
+        if (mode == VrBillboardMode::None) {
+            return false;
+        }
+
+        struct V {
+            double x, y, z;
+        };
+
+        auto dot = [](const V &a, const V &b) { return a.x * b.x + a.y * b.y + a.z * b.z; };
+        auto cross = [](const V &a, const V &b) { return V{ a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x }; };
+        auto normalize = [&](V &a, double minLength) {
+            const double l = std::sqrt(dot(a, a));
+            if (!(l > minLength)) {
+                return false;
+            }
+
+            a = V{ a.x / l, a.y / l, a.z / l };
+            return true;
+        };
+
+        const V up = { 0.0, 1.0, 0.0 };
+        const V r[3] = {
+            { m[0], m[1], m[2] },
+            { m[4], m[5], m[6] },
+            { m[8], m[9], m[10] }
+        };
+
+        const V p = { m[12], m[13], m[14] };
+
+        // The pivot, local (c) and in world space (P = c * R + p): the billboard faces from P.
+        const V c = (pivot != nullptr) ? V{ pivot[0], pivot[1], pivot[2] } : V{ 0.0, 0.0, 0.0 };
+        const V pivotWorld = {
+            c.x * r[0].x + c.y * r[1].x + c.z * r[2].x + p.x,
+            c.x * r[0].y + c.y * r[1].y + c.z * r[2].y + p.y,
+            c.x * r[0].z + c.y * r[1].z + c.z * r[2].z + p.z };
+
+        // The game camera's basis, as the billboard was built.
+        V cBack = r[2];
+        if (!normalize(cBack, 1e-12)) {
+            cBack = cross(r[0], r[1]);
+            if (!normalize(cBack, 1e-12)) {
+                return false;
+            }
+
+            const float *side = (gameViewpoint != nullptr) ? gameViewpoint : viewpoint;
+            const V toSide = { double(side[0]) - pivotWorld.x, double(side[1]) - pivotWorld.y, double(side[2]) - pivotWorld.z };
+            if (dot(cBack, toSide) < 0.0) {
+                cBack = V{ -cBack.x, -cBack.y, -cBack.z };
+            }
+        }
+
+        V cRight = cross(up, cBack);
+        if (!normalize(cRight, 1e-6)) {
+            // Built looking straight up or down: no level axis to recover.
+            return false;
+        }
+
+        const V cUp = cross(cBack, cRight);
+        if (mode == VrBillboardMode::Matching) {
+            mode = (cUp.y > 0.99999) ? VrBillboardMode::Cylindrical : VrBillboardMode::Spherical;
+        }
+
+        // The facing basis.
+        V d = { double(viewpoint[0]) - pivotWorld.x, double(viewpoint[1]) - pivotWorld.y, double(viewpoint[2]) - pivotWorld.z };
+        V eBack, eRight, eUp;
+        if (mode == VrBillboardMode::Cylindrical) {
+            d.y = 0.0;
+            eBack = d;
+            if (!normalize(eBack, 1e-6)) {
+                return false;
+            }
+
+            eRight = cross(up, eBack);
+            eUp = up;
+        }
+        else {
+            eBack = d;
+            if (!normalize(eBack, 1e-6)) {
+                return false;
+            }
+
+            eRight = cross(up, eBack);
+            if (!normalize(eRight, 1e-4)) {
+                // The viewpoint straight above or below: keep the game's level axis.
+                eRight = V{ cRight.x - eBack.x * dot(cRight, eBack), cRight.y - eBack.y * dot(cRight, eBack), cRight.z - eBack.z * dot(cRight, eBack) };
+                if (!normalize(eRight, 1e-6)) {
+                    return false;
+                }
+            }
+
+            eUp = cross(eBack, eRight);
+        }
+
+        // The new rows, and the position that keeps P in place.
+        V n[3];
+        for (int i = 0; i < 3; i++) {
+            const double lr = dot(r[i], cRight), lu = dot(r[i], cUp), lb = dot(r[i], cBack);
+            n[i] = V{ lr * eRight.x + lu * eUp.x + lb * eBack.x, lr * eRight.y + lu * eUp.y + lb * eBack.y, lr * eRight.z + lu * eUp.z + lb * eBack.z };
+            m[i * 4 + 0] = float(n[i].x);
+            m[i * 4 + 1] = float(n[i].y);
+            m[i * 4 + 2] = float(n[i].z);
+        }
+
+        if (pivot != nullptr) {
+            m[12] = float(pivotWorld.x - (c.x * n[0].x + c.y * n[1].x + c.z * n[2].x));
+            m[13] = float(pivotWorld.y - (c.x * n[0].y + c.y * n[1].y + c.z * n[2].y));
+            m[14] = float(pivotWorld.z - (c.x * n[0].z + c.y * n[1].z + c.z * n[2].z));
+        }
+
+        return true;
+    }
+};
