+//
+// RT64
+//
+
+#include "rt64_vr.h"
+
+#include <atomic>
+
+namespace RT64 {
+    static std::atomic<VrHost *> vrHost = nullptr;
+
+    void SetVrHost(VrHost *host) {
+        vrHost = host;
+    }
+
