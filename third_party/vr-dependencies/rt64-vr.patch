+    void WorkloadQueue::threadVrClassifyCalls(const Workload &workload, uint32_t mainColorAddress, const uint32_t cameraGroups[2]) {
+        // Where each game call goes in VR. In the main color image, everything up to and
+        // including the game camera stays in the eye passes (clears, backgrounds, the world), and
+        // so do perspective draws after it. 2D draws after the camera are the HUD (sprites,
+        // counters, text, the first person crosshair), except those that cover the frame
+        // (underwater tint, fades, pause darkening) or are letterbox bars, which stay in the eyes.
+        // Other framebuffers (offscreen effects) are drawn by the eye passes only.
+        vrCallClass.assign(workload.gameCallCount, uint8_t(VrCallOffscreen));
+        // Diagnostics: RT64_VR_LOG_HUD=1 lists the HUD's calls every 300th game frame.
+        // RT64_VR_LOG_HUD=<period in game frames> (1 means the default, 300).
+        static const uint64_t logHudPeriod = (getenv("RT64_VR_LOG_HUD") != nullptr) ? std::max<uint64_t>(1, strtoull(getenv("RT64_VR_LOG_HUD"), nullptr, 10)) : 0;
+        vrLogHudCalls = (logHudPeriod > 0) && ((++vrClassifyCount % ((logHudPeriod == 1) ? 300 : logHudPeriod)) == 0);
+        vrInfo.hudCalls = 0;
+        // FNV-1a per part (call state, colours, textures, positions, texcoords, vertex colours,
+        // world matrices), so a diagnostic can tell which part changed.
+        uint64_t parts[7];
+        for (uint64_t &part : parts) {
+            part = 1469598103934665603ULL;
+        }
+
+        int partIndex = 0;
+        auto hashBytes = [&parts, &partIndex](const void *data, size_t size) {
+            const uint8_t *bytes = static_cast<const uint8_t *>(data);
+            uint64_t &h = parts[partIndex];
+            for (size_t i = 0; i < size; i++) {
+                h = (h ^ bytes[i]) * 1099511628211ULL;
+            }
+        };
+        vrInfo.cameraTop = 0.0f;
+        vrInfo.cameraBottom = 1.0f;
+        vrInfo.viewportTop = 0.0f;
+        vrInfo.viewportBottom = 1.0f;
+        const DrawData &drawData = workload.drawData;
+        const float frameHeight = (workload.viFbSize[1] > 0) ? float(workload.viFbSize[1]) : 240.0f;
+        bool seenCamera = false;
+        // Only when the camera is known by its group: otherwise every perspective projection is
+        // taken as the camera.
+        const bool perspectiveHudAllowed = (vrHost != nullptr) && vrHost->perspectiveHudAfterCamera() && (cameraGroups[0] != 0);
+        for (uint32_t f = 0; f < workload.fbPairCount; f++) {
+            const FramebufferPair &fbPair = workload.fbPairs[f];
+            const bool mainImage = (mainColorAddress != 0) && (fbPair.colorImage.address == mainColorAddress);
+            const float frameWidth = (fbPair.colorImage.width > 0) ? float(fbPair.colorImage.width) : 320.0f;
+            for (uint32_t p = 0; p < fbPair.projectionCount; p++) {
+                const Projection &proj = fbPair.projections[p];
+                const bool camera = mainImage && ProjectionProcessor::isVrCamera(workload, fbPair, proj, mainColorAddress, cameraGroups);
+                if (camera && !seenCamera && !proj.scissorRect.isNull()) {
+                    vrInfo.cameraTop = std::clamp(float(proj.scissorRect.top(false)) / frameHeight, 0.0f, 1.0f);
+                    vrInfo.cameraBottom = std::clamp(float(proj.scissorRect.bottom(false)) / frameHeight, 0.0f, 1.0f);
+                    if (proj.transformsIndex < workload.drawData.rspViewports.size()) {
+                        // The viewport itself (unit ratios), not its clipping guard band.
+                        const int16_t unitRatios[4] = { -1, -1, 1, 1 };
+                        const FixedRect viewport = workload.drawData.rspViewports[proj.transformsIndex].rect(unitRatios);
+                        if (!viewport.isNull() && (viewport.lry > viewport.uly)) {
+                            vrInfo.viewportTop = float(viewport.top(false)) / frameHeight;
+                            vrInfo.viewportBottom = float(viewport.bottom(false)) / frameHeight;
+                        }
+                    }
+                }
+
+                seenCamera = seenCamera || camera;
+                for (uint32_t d = 0; d < proj.gameCallCount; d++) {
+                    const GameCall &call = proj.gameCalls[d];
+                    const uint32_t callIndex = call.callDesc.callIndex;
+                    if (callIndex >= vrCallClass.size()) {
+                        continue;
+                    }
+
+                    if (!mainImage) {
+                        continue;
+                    }
+
+                    const bool perspectiveHud = perspectiveHudAllowed && !camera && (proj.type == Projection::Type::Perspective);
+                    if (!seenCamera || ((proj.type == Projection::Type::Perspective) && !perspectiveHud) || (call.callDesc.extendedType != DrawExtendedType::None)) {
+                        vrCallClass[callIndex] = VrCallEye;
+                        continue;
+                    }
+
+                    // The call's extent in the frame (0..1, y down), when it can be found.
+                    float x0 = 0.0f, y0 = 0.0f, x1 = 0.0f, y1 = 0.0f;
+                    bool known = false;
+                    if ((proj.type == Projection::Type::Rectangle) || (call.callDesc.otherMode.cycleType() == G_CYC_FILL)) {
+                        const FixedRect &r = call.callDesc.rect;
+                        x0 = float(r.left(false)) / frameWidth;
+                        x1 = float(r.right(false)) / frameWidth;
+                        y0 = float(r.top(false)) / frameHeight;
+                        y1 = float(r.bottom(false)) / frameHeight;
+                        known = true;
+                    }
+                    else if (proj.type == Projection::Type::Orthographic) {
+                        float minX = 1e30f, minY = 1e30f, maxX = -1e30f, maxY = -1e30f;
+                        const uint32_t start = call.meshDesc.faceIndicesStart;
+                        const uint32_t end = std::min(start + call.callDesc.triangleCount * 3, uint32_t(drawData.faceIndices.size()));
+                        for (uint32_t i = start; i < end; i++) {
+                            const uint32_t v = drawData.faceIndices[i];
+                            if ((v * 3 + 2 >= drawData.posFloats.size()) || (v >= drawData.worldIndices.size()) || (v >= drawData.viewProjIndices.size())) {
+                                continue;
+                            }
+
+                            const uint16_t wi = drawData.worldIndices[v], vpi = drawData.viewProjIndices[v];
+                            if ((wi >= drawData.worldTransforms.size()) || (vpi >= drawData.viewProjTransforms.size())) {
+                                continue;
+                            }
+
+                            const interop::float4x4 &world = drawData.worldTransforms[wi];
+                            const interop::float4x4 &vp = drawData.viewProjTransforms[vpi];
+                            const float px = drawData.posFloats[v * 3 + 0], py = drawData.posFloats[v * 3 + 1], pz = drawData.posFloats[v * 3 + 2];
+                            float w4[4], c4[4];
+                            for (int k = 0; k < 4; k++) {
+                                w4[k] = px * world[0][k] + py * world[1][k] + pz * world[2][k] + world[3][k];
+                            }
+
+                            for (int k = 0; k < 4; k++) {
+                                c4[k] = w4[0] * vp[0][k] + w4[1] * vp[1][k] + w4[2] * vp[2][k] + w4[3] * vp[3][k];
+                            }
+
+                            if (std::fabs(c4[3]) < 1e-6f) {
+                                continue;
+                            }
+
+                            const float nx = c4[0] / c4[3], ny = c4[1] / c4[3];
+                            minX = std::min(minX, nx);
+                            maxX = std::max(maxX, nx);
+                            minY = std::min(minY, ny);
+                            maxY = std::max(maxY, ny);
+                            known = true;
+                        }
+
+                        x0 = (minX + 1.0f) * 0.5f;
+                        x1 = (maxX + 1.0f) * 0.5f;
+                        y0 = (1.0f - maxY) * 0.5f;
+                        y1 = (1.0f - minY) * 0.5f;
+                    }
+
+                    const bool fullWidth = known && (x0 <= 0.03f) && (x1 >= 0.97f);
+                    const bool fullFrame = fullWidth && (y0 <= 0.03f) && (y1 >= 0.97f);
+                    const bool bar = fullWidth && ((y1 - y0) < 0.35f) && ((y0 <= 0.03f) || (y1 >= 0.97f));
+                    if (fullFrame || bar) {
+                        vrCallClass[callIndex] = VrCallEye;
+                    }
+                    else {
+                        vrCallClass[callIndex] = VrCallHud;
+                        vrInfo.hudCalls++;
+                        if (vrLogHudCalls) {
+                            printf("[vr] hud call %u: %s%s, extent %.3f %.3f - %.3f %.3f%s, %u triangles, combiner %08X %08X, othermode %08X %08X\n", callIndex,
+                                (proj.type == Projection::Type::Rectangle) ? "rect" : ((proj.type == Projection::Type::Orthographic) ? "ortho" : "other"),
+                                (call.callDesc.otherMode.cycleType() == G_CYC_FILL) ? " fill" : "", x0, y0, x1, y1, known ? "" : " (unknown)", call.callDesc.triangleCount,
+                                call.callDesc.colorCombiner.L, call.callDesc.colorCombiner.H, call.callDesc.otherMode.L, call.callDesc.otherMode.H);
+                            printf("[vr] hud call %u: rect %.2f %.2f - %.2f %.2f origins %u/%u aspect %u, scissor %.2f %.2f - %.2f %.2f origins %u/%u\n", callIndex,
+                                call.callDesc.rect.ulx / 4.0f, call.callDesc.rect.uly / 4.0f, call.callDesc.rect.lrx / 4.0f, call.callDesc.rect.lry / 4.0f,
+                                call.callDesc.rectLeftOrigin, call.callDesc.rectRightOrigin, call.callDesc.rectAspect,
+                                call.callDesc.scissorRect.ulx / 4.0f, call.callDesc.scissorRect.uly / 4.0f, call.callDesc.scissorRect.lrx / 4.0f, call.callDesc.scissorRect.lry / 4.0f,
+                                call.callDesc.scissorLeftOrigin, call.callDesc.scissorRightOrigin);
+                        }
+
+                        // The signature: the call's state, its textures and its vertices.
+                        const DrawCall &desc = call.callDesc;
+                        partIndex = 0;
+                        hashBytes(&desc.triangleCount, sizeof(desc.triangleCount));
+                        hashBytes(&desc.rect, sizeof(desc.rect));
+                        hashBytes(&desc.fillColor, sizeof(desc.fillColor));
+                        hashBytes(&desc.otherMode, sizeof(desc.otherMode));
+                        hashBytes(&desc.colorCombiner, sizeof(desc.colorCombiner));
+                        partIndex = 1;
+                        hashBytes(&desc.rdpParams, sizeof(desc.rdpParams));
+                        partIndex = 2;
+
+                        for (uint32_t t = 0; t < desc.tileCount; t++) {
+                            if (desc.tileIndex + t < drawData.callTiles.size()) {
+                                const DrawCallTile &tile = drawData.callTiles[desc.tileIndex + t];
+                                hashBytes(&tile.tmemHashOrID, sizeof(tile.tmemHashOrID));
+                                hashBytes(&tile.minTexcoord, sizeof(tile.minTexcoord));
+                                hashBytes(&tile.maxTexcoord, sizeof(tile.maxTexcoord));
+                            }
+                        }
+
+                        if ((proj.type == Projection::Type::Orthographic) || perspectiveHud) {
+                            const uint32_t start = call.meshDesc.faceIndicesStart;
+                            const uint32_t end = std::min(start + desc.triangleCount * 3, uint32_t(drawData.faceIndices.size()));
+                            for (uint32_t i = start; i < end; i++) {
+                                const uint32_t v = drawData.faceIndices[i];
+                                partIndex = 3;
+                                if (v * 3 + 2 < drawData.posFloats.size()) {
+                                    hashBytes(&drawData.posFloats[v * 3], sizeof(float) * 3);
+                                }
+
+                                partIndex = 4;
+                                if (v * 2 + 1 < drawData.tcFloats.size()) {
+                                    hashBytes(&drawData.tcFloats[v * 2], sizeof(float) * 2);
+                                }
+
+                                partIndex = 5;
+                                if (v * 4 + 3 < drawData.normColBytes.size()) {
+                                    hashBytes(&drawData.normColBytes[v * 4], 4);
+                                }
+
+                                partIndex = 6;
+                                if ((v < drawData.worldIndices.size()) && (drawData.worldIndices[v] < drawData.worldTransforms.size())) {
+                                    hashBytes(&drawData.worldTransforms[drawData.worldIndices[v]], sizeof(interop::float4x4));
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+
+        uint64_t signature = 1469598103934665603ULL;
+        vrInfo.hudChangedParts = 0;
+        for (int i = 0; i < 7; i++) {
+            signature = (signature ^ parts[i]) * 1099511628211ULL;
+            if (parts[i] != vrHudParts[i]) {
+                vrInfo.hudChangedParts |= (1U << i);
+            }
+
+            vrHudParts[i] = parts[i];
+        }
+
+        vrInfo.hudSignature = signature;
+        if (vrLogHudCalls) {
+            vrLogHudCalls = false;
+            fflush(stdout);
+        }
+    }
+
+    void WorkloadQueue::renderThreadLoopVR() {
+        Thread::setCurrentThreadName("RT64 Workload VR");
+
+        // The host's display frames pace this loop. Each frame takes at most one new workload
+        // without blocking and consumes it once (configuration, game frame advance, matching);
+        // the eye passes then replay the held pair of game frames once per eye at the weight the
+        // host's display-time scheduler gives. Without eye passes, each new workload is rendered
+        // once, flat, as RT64 would at the original rate.
+        WorkloadConfiguration workloadConfig;
+        int heldCursor = -1;
+        RenderTargetKey interpolationTargetKey;
+        int32_t interpolationTargetFbPairIndex = -1;
+        bool velocityUploaderUsed = false;
+        bool tileInterpolationUsed = false;
+        bool lookAtInterpolationUsed = false;
+        float deltaTimeMs = 1.0f / 30.0f;
+        VrFrame::Mode configuredMode = VrFrame::Mode::None;
+        uint32_t configuredEyeWidth = 0;
+        uint32_t configuredFlatHeight = 0;
+        while (threadsRunning) {
+            vrFrame = vrHost->beginFrame();
+            threadVrFinishSubmission();
+            const bool displayFrame = (vrFrame.mode != VrFrame::Mode::None);
+
+            // Take the next workload if it is complete and its present event has been processed.
+            int cursor = -1;
+            {
+                const std::scoped_lock lock(cursorMutex);
+                if (writeCursor != threadCursor) {
+                    cursor = threadCursor;
+                }
+            }
+
+            if (cursor >= 0) {
+                uint64_t presentQueueId;
+                {
+                    const std::scoped_lock lock(ext.presentQueue->presentIdMutex);
+                    presentQueueId = ext.presentQueue->presentId;
+                }
+
+                if (workloads[cursor].presentId > presentQueueId) {
+                    cursor = -1;
+                }
+                else {
+                    const std::scoped_lock lock(cursorMutex);
+                    threadCursor = (threadCursor + 1) % workloads.size();
+                }
+            }
+
+            if (!threadsRunning) {
+                if (displayFrame) {
+                    vrHost->endFrame();
+                }
+
+                break;
+            }
+
+            if (!displayFrame && (cursor < 0)) {
+                std::unique_lock<std::mutex> cursorLock(cursorMutex);
+                cursorCondition.wait_for(cursorLock, std::chrono::milliseconds(2));
+                continue;
+            }
+
+            {
+                std::unique_lock<std::mutex> threadLock(threadMutex);
+                workloadProfiler.start();
+                const bool modeChanged = (vrFrame.mode != configuredMode) || (vrFrame.eyeWidth != configuredEyeWidth) || (vrFrame.flatHeight != configuredFlatHeight);
+                const int configCursor = (cursor >= 0) ? cursor : heldCursor;
+                if ((configCursor >= 0) && ((cursor >= 0) || modeChanged)) {
+                    threadConfigurationUpdate(workloads[configCursor].viFbSize, workloadConfig);
+                    configuredMode = vrFrame.mode;
+                    configuredEyeWidth = vrFrame.eyeWidth;
+                    configuredFlatHeight = vrFrame.flatHeight;
+                }
+
+                const bool newWorkload = (cursor >= 0);
+                if (newWorkload) {
+                    Workload &workload = workloads[cursor];
+                    prevFrameIndex = curFrameIndex;
+                    curFrameIndex = (curFrameIndex + 1) % gameFrames.size();
+                    GameFrame &curFrame = gameFrames[curFrameIndex];
+                    const GameFrame &prevFrame = gameFrames[prevFrameIndex];
+                    uint32_t workloadIndex = cursor;
+                    curFrame.set(*this, &workloadIndex, 1);
+
+                    interpolationTargetKey = RenderTargetKey();
+                    interpolationTargetFbPairIndex = -1;
+                    threadDetectInterpolationTarget(workload, interpolationTargetKey, interpolationTargetFbPairIndex);
+
+                    // Matching always runs: every display frame interpolates.
+                    velocityUploaderUsed = false;
+                    tileInterpolationUsed = false;
+                    lookAtInterpolationUsed = false;
+                    matchingProfiler.reset();
+                    matchingProfiler.start();
+                    curFrame.match(ext.workloadGraphicsWorker, *this, prevFrame, ext.workloadVelocityUploader, velocityUploaderUsed, tileInterpolationUsed, lookAtInterpolationUsed);
+                    matchingProfiler.end();
+                    matchingProfiler.log();
+
+                    deltaTimeMs = (workload.viOriginalRate > 0) ? (1.0f / float(workload.viOriginalRate)) : (1.0f / 30.0f);
+                    ext.sharedResources->viOriginalRate = workload.viOriginalRate;
+
+                    // The present queue's frame counters, as for a workload with one display frame.
+                    const bool useDifferentCounters = (lastPresentId != workload.presentId);
+                    if (useDifferentCounters) {
+                        ext.sharedResources->interpolatedFramesIndex = ext.sharedResources->interpolatedFramesIndex ^ 1;
+                        lastPresentId = workload.presentId;
+                    }
+
+                    {
+                        std::scoped_lock<std::mutex> interpolatedLock(ext.sharedResources->interpolatedMutex);
+                        InterpolatedFrameCounters &curFrameCounters = ext.sharedResources->interpolatedFrames[ext.sharedResources->interpolatedFramesIndex];
+                        curFrameCounters.skipped = false;
+                        curFrameCounters.presented = 0;
+                        curFrameCounters.available = 0;
+                        curFrameCounters.count = 1;
+                    }
+
+                    vrInfo = VrWorkloadInfo();
+                    vrInfo.viOriginalRate = workload.viOriginalRate;
+                    vrInfo.viWidth = workload.viFbSize[0];
+                    vrInfo.viHeight = workload.viFbSize[1];
+                    threadVrClassifyCamera(workload, interpolationTargetKey.isEmpty() ? 0 : interpolationTargetKey.address);
+                    vrHost->workloadArrived(vrInfo);
+                    heldCursor = cursor;
+                }
+
+                if (heldCursor >= 0) {
+                    Workload &workload = workloads[heldCursor];
+                    GameFrame &curFrame = gameFrames[curFrameIndex];
+                    const GameFrame &prevFrame = gameFrames[prevFrameIndex];
+                    const bool stereo = (vrFrame.mode == VrFrame::Mode::Stereo) && !interpolationTargetKey.isEmpty() && (vrFrame.eyeWidth > 0);
+                    if (stereo) {
+                        float curFrameWeight = 1.0f;
+                        float prevFrameWeight = 0.0f;
+                        vrHost->frameWeights(curFrameWeight, prevFrameWeight);
+                        if (vrRightEyeTarget == nullptr) {
+                            vrRightEyeTarget = std::make_unique<RenderTarget>(interpolationTargetKey.address, Framebuffer::Type::Color, RenderMultisampling(), ext.sharedResources->renderTargetManager.usesHDR);
+                        }
+
+                        // The HUD, once per game frame: the left eye's pass also draws the HUD's 2D
+                        // calls into a black and a white image and solves them into the host's HUD
+                        // image (rt64_vr.h, hudAcquire).
+                        vrHudFramebuffer = nullptr;
+                        if (newWorkload) {
+                            RenderFramebuffer *hudFramebuffer = vrHost->hudAcquire(vrInfo.hudCalls, vrInfo.hudSignature, &vrHudWidth, &vrHudHeight);
+                            if ((hudFramebuffer != nullptr) && (vrHudSolver == nullptr) && !vrHudSolverFailed) {
+                                vrHudSolver = std::make_unique<VrHudSolver>();
+                                if (!vrHudSolver->setup(ext.device)) {
+                                    vrHudSolver.reset();
+                                    vrHudSolverFailed = true;
+                                }
+                            }
+
+                            if ((hudFramebuffer != nullptr) && (vrHudSolver != nullptr)) {
+                                for (uint32_t h = 0; h < 2; h++) {
+                                    if (vrHudTarget[h] == nullptr) {
+                                        vrHudTarget[h] = std::make_unique<RenderTarget>(interpolationTargetKey.address, Framebuffer::Type::Color, RenderMultisampling(), ext.sharedResources->renderTargetManager.usesHDR);
+                                    }
+                                }
+
+                                vrHudFramebuffer = hudFramebuffer;
+                            }
+                        }
+
+                        // The left eye renders into the main color image itself, so later frames that
+                        // read it (and the flat output) see a coherent image; the right eye into its
+                        // own target.
+                        // RT64_VR_EYE_ORDER=swap renders the right eye first (diagnostics).
+                        static const bool swapEyes = (getenv("RT64_VR_EYE_ORDER") != nullptr) && (strcmp(getenv("RT64_VR_EYE_ORDER"), "swap") == 0);
+                        for (uint32_t pass = 0; pass < 2; pass++) {
+                            const uint32_t eye = swapEyes ? (1 - pass) : pass;
+                            ElapsedTimer eyeTimer;
+                            vrEye = int32_t(eye);
+                            vrPass = VrPass::Eye;
+                            // RT64_VR_RIGHT_TARGET=main: the right eye also renders into the main color image (diagnostics).
+                            static const bool rightInMain = (getenv("RT64_VR_RIGHT_TARGET") != nullptr) && (strcmp(getenv("RT64_VR_RIGHT_TARGET"), "main") == 0);
+                            RenderTarget *overrideTarget = ((eye == 1) && !rightInMain) ? vrRightEyeTarget.get() : nullptr;
+                            const uint32_t overrideModifier = ((eye == 1) && !rightInMain) ? 0x7E1 : 0;
+                            vrLastEyeStats = VrEyeStats();
+                            GetVrDrawStats() = VrDrawStats();
+                            {
+                                static const bool logDraws = (getenv("RT64_VR_LOG_DRAWS") != nullptr);
+                                static uint64_t logDrawFrames = 0;
+                                GetVrDrawStats().logDraws = logDraws && (eye == 1) && (((logDrawFrames++) % 1800) == 900);
+                                if (GetVrDrawStats().logDraws) {
+                                    fprintf(stdout, "[vr-draw] right eye pass, %ux%u\n", vrFrame.eyeWidth, vrFrame.eyeHeight);
+                                }
+                            }
+                            plume::GetVulkanPassStats() = plume::VulkanPassStats();
+                            static const bool deferWait = (getenv("RT64_VR_DEFER_WAIT") == nullptr) || (getenv("RT64_VR_DEFER_WAIT")[0] != '0');
+                            vrDeferSubmission = deferWait && (pass == 1);
+                            threadRenderFrame(curFrame, prevFrame, workloadConfig, workload.debuggerRenderer, workload.debuggerCamera, curFrameWeight, prevFrameWeight, deltaTimeMs,
+                                interpolationTargetKey, interpolationTargetFbPairIndex, overrideTarget, overrideModifier, velocityUploaderUsed, false, tileInterpolationUsed, lookAtInterpolationUsed);
+                            const bool deferred = vrDeferSubmission && vrPendingFinish;
+                            vrDeferSubmission = false;
+                            vrEye = -1;
+                            vrPass = VrPass::None;
+                            {
+                                VrEyeStats &st = vrLastEyeStats;
+                                const VrDrawStats &ds = GetVrDrawStats();
+                                const plume::VulkanPassStats &ps = plume::GetVulkanPassStats();
+                                st.cpuMs = eyeTimer.elapsedMicroseconds() / 1000.0;
+                                st.renderPasses = uint32_t(ps.begins);
+                                st.passMpx = double(ps.pixels) / 1e6;
+                                st.draws = ds.draws;
+                                st.uberDraws = ds.uberDraws;
+                                st.decalDraws = ds.decalDraws;
+                                st.depthSwitches = ds.depthReads + ds.depthWrites;
+                                st.testZ = ds.testZ;
+                                st.clears = ds.clears;
+                                if (deferred) {
+                                    vrPendingStats = st;
+                                    vrPendingEye = int32_t(eye);
+                                }
+                                else {
+                                    vrHost->eyeDone(eye, st);
+                                }
