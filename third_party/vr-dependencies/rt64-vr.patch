+//
+// RT64
+//
+// VR HUD alpha solve (rt64_vr.h): one full-screen draw from the HUD's black and white renders
+// into the host's HUD image. Compiled only with RT64_VR.
+//
+
+#pragma once
+
+#include <memory>
+
+#include "common/rt64_plume.h"
+#include "render/rt64_descriptor_sets.h"
+
+namespace RT64 {
+    struct VrHudSolveDescriptorSet : RenderDescriptorSetBase {
+        uint32_t gBlack;
+        uint32_t gWhite;
+
+        VrHudSolveDescriptorSet(RenderDevice *device = nullptr) {
+            builder.begin();
+            gBlack = builder.addTexture(1);
+            gWhite = builder.addTexture(2);
+            builder.end();
+
+            if (device != nullptr) {
+                create(device);
+            }
+        }
+    };
+
+    struct VrEyeCopyDescriptorSet : RenderDescriptorSetBase {
+        uint32_t gSource;
+
+        VrEyeCopyDescriptorSet(RenderDevice *device = nullptr) {
+            builder.begin();
+            gSource = builder.addTexture(1);
+            builder.end();
+
+            if (device != nullptr) {
+                create(device);
+            }
+        }
+    };
+
+    // The finished eye image drawn 1:1 into the host's eye image (rt64_vr.h, eyeFramebuffer).
+    class VrEyeCopier {
+    public:
+        bool setup(RenderDevice *device);
+        // source in SHADER_READ; dst an R8G8B8A8_UNORM colour attachment in COLOR_WRITE (left there).
+        void record(RenderCommandList *commandList, uint32_t eye, RenderTexture *source, RenderFramebuffer *dst, uint32_t width, uint32_t height);
+
+    private:
+        std::unique_ptr<RenderPipelineLayout> pipelineLayout;
+        std::unique_ptr<RenderPipeline> pipeline;
+        std::unique_ptr<VrEyeCopyDescriptorSet> descriptorSets[2];
+        RenderTexture *boundSource[2] = {};
+    };
+
+    // The headset's hidden-area mesh drawn into an eye's colour (black) and depth (near plane)
+    // before its scene (rt64_vr.h, hiddenMesh).
+    class VrHiddenMask {
+    public:
+        bool setup(RenderDevice *device);
+        // The framebuffer's colour and depth attachments are in COLOR_WRITE and DEPTH_WRITE.
+        void record(RenderCommandList *commandList, uint32_t eye, const float *ndcXY, uint32_t vertexCount, const RenderFramebuffer *framebuffer, uint32_t width, uint32_t height);
+
+    private:
+        RenderDevice *device = nullptr;
+        std::unique_ptr<RenderPipelineLayout> pipelineLayout;
+        std::unique_ptr<RenderPipeline> pipeline;
+        std::unique_ptr<RenderBuffer> vertexBuffers[2];
+        uint32_t vertexCapacity[2] = {};
+    };
+
+    class VrHudSolver {
+    public:
+        // The destination is an R8G8B8A8_UNORM colour attachment (the host's swapchain image).
+        bool setup(RenderDevice *device);
+        // black and white must be in SHADER_READ; dst in COLOR_WRITE (left there).
+        void record(RenderCommandList *commandList, RenderTexture *black, RenderTexture *white, uint32_t srcWidth, uint32_t srcHeight,
+            RenderFramebuffer *dst, uint32_t dstWidth, uint32_t dstHeight);
+
+    private:
+        std::unique_ptr<RenderPipelineLayout> pipelineLayout;
+        std::unique_ptr<RenderPipeline> pipeline;
+        std::unique_ptr<VrHudSolveDescriptorSet> descriptorSet;
+        RenderTexture *boundBlack = nullptr;
+        RenderTexture *boundWhite = nullptr;
+    };
+};
