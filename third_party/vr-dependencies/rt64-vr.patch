+
+                const float x = drawData.posFloats[v * 3 + 0], y = drawData.posFloats[v * 3 + 1], z = drawData.posFloats[v * 3 + 2];
+                const float wx = x * world[0][0] + y * world[1][0] + z * world[2][0] + world[3][0];
+                const float wy = x * world[0][1] + y * world[1][1] + z * world[2][1] + world[3][1];
+                const float wz = x * world[0][2] + y * world[1][2] + z * world[2][2] + world[3][2];
+                const float dx = wx - center[0], dz = wz - center[2];
+                if ((dx * dx + dz * dz) > radiusSq) {
+                    continue;
+                }
+
+                minY = std::min(minY, wy);
+                maxY = std::max(maxY, wy);
+                counted++;
+            }
+
+            vrHost->playerExtent(minY, maxY, counted);
+        }
+    }
