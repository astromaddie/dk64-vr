diff --git a/src/shaders/VrEyeCopyPS.hlsl b/src/shaders/VrEyeCopyPS.hlsl
new file mode 100644
index 0000000..10ce152
--- /dev/null
+++ b/src/shaders/VrEyeCopyPS.hlsl
@@ -0,0 +1,14 @@
+//
+// RT64
+//
+// VR eye copy (rt64_vr.h): the finished eye image drawn 1:1 into the host's swapchain image
+// through a view of the same encoding, so the bits are copied unchanged. On Adreno a draw is
+// several times cheaper than vkCmdCopyImage between the two images (UNORM to sRGB, both
+// compressed). Compiled only with RT64_VR.
+//
+
+Texture2D<float4> gSource : register(t1);
+
+float4 PSMain(in float4 pos : SV_Position) : SV_TARGET {
+    return gSource.Load(int3(int2(pos.xy), 0));
+}
diff --git a/src/shaders/VrHudSolvePS.hlsl b/src/shaders/VrHudSolvePS.hlsl
new file mode 100644
index 0000000..b832185
--- /dev/null
+++ b/src/shaders/VrHudSolvePS.hlsl
@@ -0,0 +1,31 @@
+//
+// RT64
+//
+// VR HUD: the HUD drawn once over black and once over white gives, per pixel, the colour the
+// game blended (b = a * c) and its coverage (w - b = 1 - a) without trusting the framebuffer's
+// alpha, which N64 games use as scratch. The output is unpremultiplied (c, a) in the targets'
+// own (gamma) encoding, for a quad layer composited with source alpha.
+//
+
+struct VrHudSolveCB {
+    uint2 size;
+    uint debugSplit;  // diagnostics: left half the black render, right half the white one
+};
+
+[[vk::push_constant]] ConstantBuffer<VrHudSolveCB> gConstants : register(b0);
+
+Texture2D<float4> gBlack : register(t1);
+Texture2D<float4> gWhite : register(t2);
+
+float4 PSMain(in float4 pos : SV_Position, in float2 uv : TEXCOORD0) : SV_TARGET {
+    uint2 pixelPos = min(uint2(uv * float2(gConstants.size)), gConstants.size - uint2(1, 1));
+    float3 b = gBlack.Load(uint3(pixelPos, 0)).rgb;
+    float3 w = gWhite.Load(uint3(pixelPos, 0)).rgb;
+    if (gConstants.debugSplit != 0) {
+        return float4((uv.x < 0.5f) ? b : w, 1.0f);
+    }
+
+    float a = saturate(1.0f - dot(w - b, float3(1.0f, 1.0f, 1.0f) / 3.0f));
+    float3 c = (a > (1.0f / 255.0f)) ? saturate(b / a) : float3(0.0f, 0.0f, 0.0f);
+    return float4(c, a);
+}
