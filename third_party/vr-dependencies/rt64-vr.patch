diff --git a/src/hle/rt64_vr.h b/src/hle/rt64_vr.h
new file mode 100644
index 0000000..fbadbd1
--- /dev/null
+++ b/src/hle/rt64_vr.h
@@ -0,0 +1,196 @@
+//
+// RT64
+//
+// Optional VR host interface. A host (an OpenXR layer in the application) can take over the
+// workload thread's pacing and output: it waits for and begins each display frame, chooses
+// between stereo eye passes and a flat render, places the camera for each eye, and receives the
+// finished eye images and the flat output (as a panel). Without a host, RT64 runs as before.
+// Compiled only with RT64_VR.
+//
+
+#pragma once
+
+#include <cstdint>
+
+#include "common/rt64_plume.h"
+#include "shared/rt64_vr_billboard.h"
+
+namespace RT64 {
+    struct VrFrame {
+        enum class Mode {
+            // No display frame (no session yet, or it stopped): consume and render as usual.
+            None,
+            // A display frame without eye passes (a panel, standby, the probe): consume and render
+            // each new workload once, flat.
+            Flat,
+            // Eye passes: the held pair of game frames is rendered once per eye every frame.
+            Stereo
+        };
+
+        Mode mode = Mode::None;
+        uint32_t eyeWidth = 0;
+        uint32_t eyeHeight = 0;
+        // Height of the flat output in pixels (the panel); 0 keeps RT64's own resolution.
+        uint32_t flatHeight = 0;
+    };
+
+    struct VrWorkloadInfo {
+        uint32_t viOriginalRate = 0;
+        uint32_t cameraProjections = 0;  // perspective projections taken as the game camera
+        bool cameraFromGroup = false;    // found through the camera's matrix groups
+        uint32_t mainColorAddress = 0;
+        uint32_t viWidth = 0;
+        uint32_t viHeight = 0;
+        // 2D draws after the camera in the main color image that are taken out of the eye passes
+        // and drawn into the HUD image instead (see hudAcquire).
+        uint32_t hudCalls = 0;
+        // A hash of everything those draws depend on: equal signatures draw the same HUD.
+        uint64_t hudSignature = 0;
+        // Diagnostics: which parts of the signature changed since the last game frame (bits:
+        // call state, colours, textures, positions, texcoords, vertex colours, world matrices).
+        uint32_t hudChangedParts = 0;
+        // The first camera projection's scissor, as fractions of the frame (0 top, 1 bottom):
+        // the picture between letterbox bars.
+        float cameraTop = 0.0f;
+        float cameraBottom = 1.0f;
+        // Its viewport, as fractions of the frame: the camera's projection spans these rows (DK64
+        // narrows the viewport, and the projection's aspect, to the letterbox band).
+        float viewportTop = 0.0f;
+        float viewportBottom = 1.0f;
+        // The game camera's view (row-major 4x4, RT64's row-vector convention) as the game set it
+        // for this frame, before any interpolation: the first camera projection's, preferring the
+        // primary camera group. The host's camera smoothing keeps a history of these.
+        bool cameraViewValid = false;
+        float cameraView[16] = {};
+    };
+
+    // One eye pass, for the host's frame statistics.
+    struct VrEyeStats {
+        double cpuMs = 0.0;          // wall time of the whole pass on the workload thread
+        double recordMs = 0.0;       // CPU until the submission
+        double submitMs = 0.0;       // the submission call itself
+        double waitMs = 0.0;         // waiting for the GPU to finish (0 for a deferred pass)
+        double gpuMs = 0.0;          // RT64's passes (timestamps around the framebuffer pairs)
+        double gpuCopyMs = 0.0;      // after them: the eye copy (and the HUD solve)
+        uint32_t renderPasses = 0;   // render passes begun
+        double passMpx = 0.0;        // their total area, millions of pixels
+        uint32_t draws = 0;
+        uint32_t uberDraws = 0;      // drawn with the ubershader (no specialized pipeline yet)
+        uint32_t decalDraws = 0;
+        uint32_t depthSwitches = 0;  // depth-write <-> depth-read framebuffer switches
+        uint32_t testZ = 0;
+        uint32_t clears = 0;
+    };
+
+    class VrHost {
+    public:
+        virtual ~VrHost() = default;
+
+        // Workload thread. Waits for and begins the next display frame (or returns Mode::None at
+        // once when there is none).
+        virtual VrFrame beginFrame() = 0;
+
+        // Workload thread. A new game frame was consumed during the current display frame.
+        virtual void workloadArrived(const VrWorkloadInfo &info) = 0;
+
+        // Workload thread. Interpolation weights for the current display frame (cur) and the one
+        // before it (prev).
+        virtual void frameWeights(float &curWeight, float &prevWeight) = 0;
+
+        // Matrix groups that mark the game's camera projection (up to two; 0 = unused). When no
+        // perspective projection in the main color image carries one, every perspective
+        // projection drawn there is taken as the camera.
+        virtual void cameraGroups(uint32_t &primary, uint32_t &secondary) const = 0;
+
+        // Perspective projections drawn into the main color image after the camera that carry
+        // none of the camera groups (only when the camera was found by its group). False keeps
+        // them in the eye passes (DK64); true sends them to the HUD, for games that draw 3D HUD
+        // items through their own perspective projection (Banjo-Kazooie's honeycombs, notes and
+        // jiggies, PROJECTION_HUD_TRANSFORM_ID).
+        virtual bool perspectiveHudAfterCamera() const { return false; }
+
+        // Workload thread, eye passes. Replaces a camera projection's interpolated view and
+        // projection (row-major 4x4, RT64's row-vector convention) for one eye.
+        virtual void eyeCamera(uint32_t eye, const float view[16], const float proj[16], float outView[16], float outProj[16]) = 0;
+
+        // Matrix groups whose model matrices are camera-facing billboards (rt64_vr_billboard.h).
+        // In eye passes RT64 turns them to face billboardViewpoint after interpolation. None by
+        // default.
+        virtual uint32_t billboardGroups(const VrBillboardGroup **groups) const { return 0; }
+
+        // Workload thread, eye passes, right after eyeCamera for the same projection (only when
+        // billboardGroups names any): the point billboards face, in the world space of the view
+        // eyeCamera was given, from the same pose as the eye's view. False leaves them facing the
+        // game camera (a cinema screen). The billboards of a workload face the point given for the
+        // camera projection in the primary camera group, else for its first camera projection.
+        virtual bool billboardViewpoint(uint32_t eye, float point[3]) { return false; }
+
+        // Workload thread, eye passes. Records the copy of the finished eye image (the main color
+        // target, its top-left width x height) into the eye's output, in the pass's command list
+        // before it is submitted. The source is in the SHADER_READ layout and must be left there.
+        // `drawn`: RT64 already drew the image into eyeFramebuffer's framebuffer; the host only
+        // finishes its own bookkeeping (dumps) and leaves that image in COLOR_WRITE.
+        virtual void recordEye(uint32_t eye, RenderCommandList *commandList, RenderTexture *source, uint32_t width, uint32_t height, bool drawn) = 0;
+        // Workload thread, eye passes. The eye's output image as an R8G8B8A8_UNORM colour
+        // attachment in COLOR_WRITE (a view of the swapchain image keeping its bits), for RT64
+        // to draw the finished image into. Null: RT64 lets recordEye copy it.
+        virtual RenderFramebuffer *eyeFramebuffer(uint32_t eye, uint32_t *width, uint32_t *height) = 0;
+
+        // Workload thread, eye passes. The eye's commands completed on the GPU.
+        virtual void eyeDone(uint32_t eye, const VrEyeStats &stats) = 0;
+
+        // Workload thread, eye passes. The headset's hidden-area triangles for the eye: a triangle
+        // list of x, y pairs in the eye image's normalized device coordinates (y up), or 0 when
+        // there are none. RT64 draws them at the near plane before the eye's scene, so depth-tested
+        // draws skip pixels the lenses never show.
+        virtual uint32_t hiddenMesh(uint32_t eye, const float **ndcXY) = 0;
+
+        // Optional: a companion framebuffer with a rate attachment for this eye's main
+        // raster pass only. Normal images stay authoritative/sampleable. The host can
+        // decline (off, cinema, unsupported) by returning the original framebuffer.
+        virtual RenderFramebuffer *foveatedFramebuffer(uint32_t eye, RenderCommandList *commandList, RenderFramebuffer *framebuffer) {
+            return framebuffer;
+        }
+        // Full-rate exceptions inside an attached pass (pixel-exact dither/decals/2D).
+        virtual void setFoveationRate(RenderCommandList *commandList, bool useAttachment) {}
+
+        // Workload thread, diagnostics. When this returns true for a new workload, RT64 measures the
+        // world-space height range of the vertices drawn through the camera whose model matrix and
+        // position lie within `radius` (horizontally) of `center`, and reports it to playerExtent.
+        virtual bool wantPlayerExtent(float center[3], float &radius) = 0;
+        virtual void playerExtent(float minY, float maxY, uint32_t vertexCount) = 0;
+
+        // Workload thread, eye passes, a display frame that consumed a new game frame. The HUD (the
+        // workload's `hudCalls` 2D draws, which the eye passes leave out) is rendered over black
+        // and over white and solved into the returned framebuffer: an R8G8B8A8_UNORM colour
+        // attachment in COLOR_WRITE (left there), the size of the eye image. Null skips the HUD.
+        // hudRecorded follows once those commands completed.
+        virtual RenderFramebuffer *hudAcquire(uint32_t hudCalls, uint64_t hudSignature, uint32_t *width, uint32_t *height) = 0;
+        virtual void hudRecorded(double cpuMs, double gpuMs) = 0;
+
+        // Workload thread. Ends the display frame begun by beginFrame (any mode but None).
+        virtual void endFrame() = 0;
+
+        // Present thread. The image the flat output should be drawn into instead of the window's
+        // swap chain, ready for drawing (COLOR_WRITE). Null when there is none this time; the
+        // present is then skipped. Released by panelRelease once its commands completed.
+        virtual RenderFramebuffer *panelAcquire(RenderTexture **texture, uint32_t *width, uint32_t *height) = 0;
+        virtual void panelRelease() = 0;
+
+        // Present thread, after a successful panelAcquire: true draws only the UI hook into the
+        // panel image, over transparent black (a menu that floats over the world), without the
+        // game's output under it.
+        virtual bool panelUiOnly() { return false; }
+
+        // VI thread: true makes every screen update a present, also in present-early mode and when
+        // nothing on screen changed (presents otherwise follow the game's workloads): a host menu
+        // drawn by the UI hook over a paused game.
+        virtual bool presentWithoutWorkloads() { return false; }
+
+        // Workload thread, when it exits.
+        virtual void threadExit() = 0;
+    };
+
+    void SetVrHost(VrHost *host);
+    VrHost *GetVrHost();
+};
diff --git a/src/hle/rt64_vr_hud.cpp b/src/hle/rt64_vr_hud.cpp
new file mode 100644
index 0000000..0dc6021
--- /dev/null
+++ b/src/hle/rt64_vr_hud.cpp
@@ -0,0 +1,181 @@
+//
+// RT64
+//
+
+#include "rt64_vr_hud.h"
+
+#include <cstdlib>
+
+#include "shaders/FullScreenVS.hlsl.spirv.h"
+#include "shaders/VrHudSolvePS.hlsl.spirv.h"
+#include "shaders/VrEyeCopyPS.hlsl.spirv.h"
+#include "shaders/VrMaskVS.hlsl.spirv.h"
+#include "shaders/VrMaskPS.hlsl.spirv.h"
+
+#include <cstring>
+
+namespace RT64 {
+    bool VrEyeCopier::setup(RenderDevice *device) {
+        VrEyeCopyDescriptorSet layoutSet;
+        RenderPipelineLayoutBuilder layoutBuilder;
+        layoutBuilder.begin();
+        layoutBuilder.addDescriptorSet(layoutSet);
+        layoutBuilder.end();
+        pipelineLayout = layoutBuilder.create(device);
+
+        std::unique_ptr<RenderShader> vertexShader = device->createShader(FullScreenVSBlobSPIRV, sizeof(FullScreenVSBlobSPIRV), "VSMain", RenderShaderFormat::SPIRV);
+        std::unique_ptr<RenderShader> pixelShader = device->createShader(VrEyeCopyPSBlobSPIRV, sizeof(VrEyeCopyPSBlobSPIRV), "PSMain", RenderShaderFormat::SPIRV);
+        RenderGraphicsPipelineDesc pipelineDesc;
+        pipelineDesc.pipelineLayout = pipelineLayout.get();
+        pipelineDesc.renderTargetBlend[0] = RenderBlendDesc::Copy();
+        pipelineDesc.renderTargetFormat[0] = RenderFormat::R8G8B8A8_UNORM;
+        pipelineDesc.renderTargetCount = 1;
+        pipelineDesc.vertexShader = vertexShader.get();
+        pipelineDesc.pixelShader = pixelShader.get();
+        pipeline = device->createGraphicsPipeline(pipelineDesc);
+        for (uint32_t eye = 0; eye < 2; eye++) {
+            descriptorSets[eye] = std::make_unique<VrEyeCopyDescriptorSet>(device);
+        }
+
+        return (pipeline != nullptr);
+    }
+
+    void VrEyeCopier::record(RenderCommandList *commandList, uint32_t eye, RenderTexture *source, RenderFramebuffer *dst, uint32_t width, uint32_t height) {
+        if ((pipeline == nullptr) || (dst == nullptr) || (source == nullptr) || (eye > 1)) {
+            return;
+        }
+
+        if (source != boundSource[eye]) {
+            // The workload thread waits for every submission it makes, so the set is idle here.
+            descriptorSets[eye]->setTexture(descriptorSets[eye]->gSource, source, RenderTextureLayout::SHADER_READ);
+            boundSource[eye] = source;
+        }
+
+        commandList->setFramebuffer(dst);
+        commandList->setPipeline(pipeline.get());
+        commandList->setGraphicsPipelineLayout(pipelineLayout.get());
+        commandList->setGraphicsDescriptorSet(descriptorSets[eye]->get(), 0);
+        commandList->setViewports(RenderViewport(0.0f, 0.0f, float(width), float(height)));
+        commandList->setScissors(RenderRect(0, 0, int32_t(width), int32_t(height)));
+        commandList->setVertexBuffers(0, nullptr, 0, nullptr);
+        commandList->drawInstanced(3, 1, 0, 0);
+        commandList->setFramebuffer(nullptr);
+    }
+
+    bool VrHiddenMask::setup(RenderDevice *device) {
+        this->device = device;
+        RenderPipelineLayoutBuilder layoutBuilder;
+        layoutBuilder.begin(false, true);
+        layoutBuilder.end();
+        pipelineLayout = layoutBuilder.create(device);
+
+        static const RenderInputSlot slots[] = { RenderInputSlot(0, sizeof(float) * 2) };
+        static const RenderInputElement elements[] = { RenderInputElement("POSITION", 0, 0, RenderFormat::R32G32_FLOAT, 0, 0) };
+        std::unique_ptr<RenderShader> vertexShader = device->createShader(VrMaskVSBlobSPIRV, sizeof(VrMaskVSBlobSPIRV), "VSMain", RenderShaderFormat::SPIRV);
+        std::unique_ptr<RenderShader> pixelShader = device->createShader(VrMaskPSBlobSPIRV, sizeof(VrMaskPSBlobSPIRV), "PSMain", RenderShaderFormat::SPIRV);
+        RenderGraphicsPipelineDesc pipelineDesc;
+        pipelineDesc.pipelineLayout = pipelineLayout.get();
+        pipelineDesc.renderTargetBlend[0] = RenderBlendDesc::Copy();
+        pipelineDesc.renderTargetFormat[0] = RenderFormat::R8G8B8A8_UNORM;
+        pipelineDesc.renderTargetCount = 1;
+        // The scene's own direction (LESS), so the driver's low-resolution Z stays usable.
+        pipelineDesc.depthEnabled = true;
+        pipelineDesc.depthWriteEnabled = true;
+        pipelineDesc.depthFunction = RenderComparisonFunction::LESS;
+        pipelineDesc.depthTargetFormat = RenderFormat::D32_FLOAT;
+        pipelineDesc.inputSlots = slots;
+        pipelineDesc.inputSlotsCount = 1;
+        pipelineDesc.inputElements = elements;
+        pipelineDesc.inputElementsCount = 1;
+        pipelineDesc.primitiveTopology = RenderPrimitiveTopology::TRIANGLE_LIST;
+        pipelineDesc.vertexShader = vertexShader.get();
+        pipelineDesc.pixelShader = pixelShader.get();
+        pipeline = device->createGraphicsPipeline(pipelineDesc);
+        return (pipeline != nullptr);
+    }
+
+    void VrHiddenMask::record(RenderCommandList *commandList, uint32_t eye, const float *ndcXY, uint32_t vertexCount, const RenderFramebuffer *framebuffer, uint32_t width, uint32_t height) {
+        if ((pipeline == nullptr) || (eye > 1) || (ndcXY == nullptr) || (vertexCount < 3) || (framebuffer == nullptr)) {
+            return;
+        }
+
+        // One buffer an eye, rewritten each pass: the workload thread has waited for the eye's
+        // previous pass before recording it again.
+        if ((vertexBuffers[eye] == nullptr) || (vertexCapacity[eye] < vertexCount)) {
+            vertexCapacity[eye] = std::max(vertexCount, 256U);
+            vertexBuffers[eye] = device->createBuffer(RenderBufferDesc::VertexBuffer(uint64_t(vertexCapacity[eye]) * sizeof(float) * 2, RenderHeapType::UPLOAD));
+        }
+
+        void *mapped = vertexBuffers[eye]->map();
+        if (mapped == nullptr) {
+            return;
+        }
+
+        memcpy(mapped, ndcXY, size_t(vertexCount) * sizeof(float) * 2);
+        vertexBuffers[eye]->unmap();
+
+        const RenderVertexBufferView view(vertexBuffers[eye].get(), uint32_t(vertexCount * sizeof(float) * 2));
+        const RenderInputSlot slot(0, sizeof(float) * 2);
+        commandList->setFramebuffer(framebuffer);
+        commandList->setPipeline(pipeline.get());
+        commandList->setGraphicsPipelineLayout(pipelineLayout.get());
+        commandList->setViewports(RenderViewport(0.0f, 0.0f, float(width), float(height)));
+        commandList->setScissors(RenderRect(0, 0, int32_t(width), int32_t(height)));
+        commandList->setVertexBuffers(0, &view, 1, &slot);
+        commandList->drawInstanced(vertexCount, 1, 0, 0);
+        commandList->setFramebuffer(nullptr);
+    }
+
+    bool VrHudSolver::setup(RenderDevice *device) {
+        VrHudSolveDescriptorSet layoutSet;
+        RenderPipelineLayoutBuilder layoutBuilder;
+        layoutBuilder.begin();
+        layoutBuilder.addPushConstant(0, 0, sizeof(uint32_t) * 3, RenderShaderStageFlag::PIXEL);
+        layoutBuilder.addDescriptorSet(layoutSet);
+        layoutBuilder.end();
+        pipelineLayout = layoutBuilder.create(device);
+
+        std::unique_ptr<RenderShader> vertexShader = device->createShader(FullScreenVSBlobSPIRV, sizeof(FullScreenVSBlobSPIRV), "VSMain", RenderShaderFormat::SPIRV);
+        std::unique_ptr<RenderShader> pixelShader = device->createShader(VrHudSolvePSBlobSPIRV, sizeof(VrHudSolvePSBlobSPIRV), "PSMain", RenderShaderFormat::SPIRV);
+        RenderGraphicsPipelineDesc pipelineDesc;
+        pipelineDesc.pipelineLayout = pipelineLayout.get();
+        pipelineDesc.renderTargetBlend[0] = RenderBlendDesc::Copy();
+        pipelineDesc.renderTargetFormat[0] = RenderFormat::R8G8B8A8_UNORM;
+        pipelineDesc.renderTargetCount = 1;
+        pipelineDesc.vertexShader = vertexShader.get();
+        pipelineDesc.pixelShader = pixelShader.get();
+        pipeline = device->createGraphicsPipeline(pipelineDesc);
+        descriptorSet = std::make_unique<VrHudSolveDescriptorSet>(device);
+        return (pipeline != nullptr);
+    }
+
+    void VrHudSolver::record(RenderCommandList *commandList, RenderTexture *black, RenderTexture *white, uint32_t srcWidth, uint32_t srcHeight,
+        RenderFramebuffer *dst, uint32_t dstWidth, uint32_t dstHeight)
+    {
+        if ((pipeline == nullptr) || (dst == nullptr)) {
+            return;
+        }
+
+        if ((black != boundBlack) || (white != boundWhite)) {
+            // Descriptor writes must not race a submission still using the set: the workload
+            // thread waits for every submission it makes, so the set is idle here.
+            descriptorSet->setTexture(descriptorSet->gBlack, black, RenderTextureLayout::SHADER_READ);
+            descriptorSet->setTexture(descriptorSet->gWhite, white, RenderTextureLayout::SHADER_READ);
+            boundBlack = black;
+            boundWhite = white;
+        }
+
+        static const bool debugSplit = (getenv("RT64_VR_HUD_DEBUG") != nullptr);
+        const uint32_t size[3] = { srcWidth, srcHeight, debugSplit ? 1U : 0U };
+        commandList->setFramebuffer(dst);
+        commandList->setPipeline(pipeline.get());
+        commandList->setGraphicsPipelineLayout(pipelineLayout.get());
+        commandList->setGraphicsDescriptorSet(descriptorSet->get(), 0);
+        commandList->setGraphicsPushConstants(0, size);
+        commandList->setViewports(RenderViewport(0.0f, 0.0f, float(dstWidth), float(dstHeight)));
+        commandList->setScissors(RenderRect(0, 0, int32_t(dstWidth), int32_t(dstHeight)));
+        commandList->setVertexBuffers(0, nullptr, 0, nullptr);
+        commandList->drawInstanced(3, 1, 0, 0);
+        commandList->setFramebuffer(nullptr);
+    }
+};
