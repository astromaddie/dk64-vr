+#if PLUME_VULKAN_CREATE_HOOKS
+    VkResult VulkanFramebuffer::createCompatibleRenderPass(const VkRenderPassCreateInfo &info, VkRenderPass *pass) const {
+        // All variants must carry the same rate attachment and subpass pNext. Stored
+        // attachmentDescs contain only colour/depth; this helper appends the read-only map.
+        if (shadingRateView != VK_NULL_HANDLE) {
+            VulkanShadingRateAttachment rate;
+            rate.imageView = shadingRateView;
+            rate.texelSize = shadingRateTexelSize;
+            return createShadingRateRenderPass(device, info, rate, pass);
+        }
+
+        return vkCreateRenderPass(device->vk, &info, nullptr, pass);
+    }
+
+    VkRenderPass VulkanFramebuffer::getClearRenderPass(uint32_t clearMask) const {
+        std::scoped_lock lock(clearPassMutex);
+        for (const auto &pass : clearPasses) {
+            if (pass.first == clearMask) {
+                return pass.second;
+            }
+        }
+
+        // The same attachments, formats, layouts and subpass: compatible with the framebuffer.
+        std::vector<VkAttachmentDescription> attachments = attachmentDescs;
+        for (uint32_t i = 0; i < colorReferences.size(); i++) {
+            if (clearMask & (1U << i)) {
+                attachments[colorReferences[i].attachment].loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+            }
+        }
+
+        const bool hasDepth = (depthAttachment != nullptr);
+        if (hasDepth && (clearMask & 0x100)) {
+            attachments[depthReference.attachment].loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+            attachments[depthReference.attachment].stencilLoadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+        }
+
+        VkSubpassDescription subpass = {};
+        subpass.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+        subpass.pColorAttachments = !colorReferences.empty() ? colorReferences.data() : nullptr;
+        subpass.colorAttachmentCount = uint32_t(colorReferences.size());
+        subpass.pDepthStencilAttachment = hasDepth ? &depthReference : nullptr;
+
+        VkRenderPassCreateInfo passInfo = {};
+        passInfo.sType = VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO;
+        passInfo.pAttachments = attachments.data();
+        passInfo.attachmentCount = uint32_t(attachments.size());
+        passInfo.pSubpasses = &subpass;
+        passInfo.subpassCount = 1;
+
+        VkRenderPass pass = VK_NULL_HANDLE;
+        VkResult res = createCompatibleRenderPass(passInfo, &pass);
+        if (res != VK_SUCCESS) {
+            fprintf(stderr, "vkCreateRenderPass (clear variant) failed with error code 0x%X.\n", res);
+            return VK_NULL_HANDLE;
+        }
+
+        clearPasses.emplace_back(clearMask, pass);
+        return pass;
+    }
+
+    VulkanFramebuffer *VulkanFramebuffer::withShadingRate(const VulkanShadingRateAttachment &rate) {
+        if (!shadingRateFramebuffer || shadingRateFramebuffer->shadingRateView != rate.imageView
+            || shadingRateFramebuffer->shadingRateTexelSize.width != rate.texelSize.width
+            || shadingRateFramebuffer->shadingRateTexelSize.height != rate.texelSize.height) {
+            std::vector<const RenderTexture *> colors(colorAttachments.begin(), colorAttachments.end());
+            RenderFramebufferDesc desc;
+            desc.colorAttachments = colors.data();
+            desc.colorAttachmentsCount = uint32_t(colors.size());
+            desc.colorAttachmentViews = savedColorViews.empty() ? nullptr : savedColorViews.data();
+            desc.depthAttachment = depthAttachment;
+            desc.depthAttachmentView = savedDepthView;
+            desc.depthAttachmentReadOnly = depthAttachmentReadOnly;
+            shadingRateFramebuffer = std::make_unique<VulkanFramebuffer>(device, desc, &rate);
+        }
+        return shadingRateFramebuffer->vk != VK_NULL_HANDLE ? shadingRateFramebuffer.get() : nullptr;
+    }
+#endif
