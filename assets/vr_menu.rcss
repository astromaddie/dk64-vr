/*
  The in-headset VR settings menu (src/vr/menu/dk64vr_menu.cpp writes the body). Units are panel
  pixels: the 1920 x 1080 panel is 2.2 m wide at 2 m, so 1 degree is about 30 px. Text is 26 px
  or larger and every target at least 76 px (2.5 degrees). Colours are the recompui theme's
  (src/main/theme.cpp): orange (Secondary) marks the pad focus, blue (Primary) the chosen value.
  Outside the window the panel is transparent: the frozen, dimmed world shows around it.
*/
body {
    width: 1920px;
    height: 1080px;
    margin: 0px;
    padding: 0px;
    background-color: rgba(0, 0, 0, 0);
    font-family: "Inter Variable";
    font-weight: 400;
    font-size: 28px;
    line-height: 1.3;
    color: rgb(242, 242, 242);
}

div { display: block; }
div, span { box-sizing: border-box; }

.vrm {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 1920px;
    height: 1080px;
}

/* Over a recomp menu or the launcher, hide what is under the window. */
.vrm.covering { background-color: rgba(10, 10, 11, 0.94); }

.g { font-family: promptfont; font-weight: 400; line-height: 1; }
.sp { flex: 1 1 0px; }

/* ---- text ---- */
.h3 { font-size: 46px; font-weight: 700; line-height: 1; white-space: nowrap; }
.h4 { font-size: 28px; font-weight: 700; letter-spacing: 2.8px; text-transform: uppercase; color: rgba(255, 255, 255, 0.72); white-space: nowrap; }
.p-label { font-size: 34px; font-weight: 600; line-height: 1.15; color: rgb(242, 242, 242); }
.p-desc { font-size: 26px; line-height: 1.32; color: rgb(204, 204, 204); margin-top: 6px; }
.p-desc.why { color: rgb(255, 215, 148); }
.p-badge {
    display: inline-block;
    margin-left: 16px;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    line-height: 1;
    padding: 7px 12px;
    border-radius: 10px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.4);
    color: rgb(204, 204, 204);
}
.chip {
    font-size: 26px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    line-height: 1;
    padding: 13px 18px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.1);
    color: rgb(204, 204, 204);
    white-space: nowrap;
}

/* ---- the pad focus: a pulsing orange ring over the focused control or row ---- */
@keyframes pulse {
    from { border-color: rgb(247, 158, 8); }
    to { border-color: rgb(255, 215, 148); }
}
.ring {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    border-width: 4px;
    border-color: rgb(247, 158, 8);
    border-radius: 18px;
    animation: 0.75s sine-in-out infinite alternate pulse;
    pointer-events: none;
}
.vc-tile.focus, .vb-row.focus { background-color: rgba(247, 158, 8, 0.08); }
/* Rows have no fixed height, so their focus is their own border (no layout shift). */
.vb-row.focus { border-color: rgb(247, 158, 8); animation: 0.75s sine-in-out infinite alternate pulse; }

/* ---- segmented choice ---- */
.p-seg {
    display: flex;
    flex-direction: row;
    padding: 6px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 20px;
    background-color: rgba(255, 255, 255, 0.05);
}
.p-seg .sb {
    height: 76px;
    min-width: 76px;
    padding: 0px 24px;
    margin-left: 6px;
    border-radius: 14px;
    font-size: 27px;
    font-weight: 600;
    letter-spacing: 1.35px;
    text-transform: uppercase;
    line-height: 76px;
    text-align: center;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.6);
}
.p-seg .sb:first-child { margin-left: 0px; }
.p-seg.n4 .sb { padding: 0px 15px; }
.p-seg .sb.hov { background-color: rgba(255, 255, 255, 0.1); color: rgba(255, 255, 255, 0.9); }
.p-seg .sb.on { background-color: rgb(29, 93, 226); color: rgb(255, 255, 255); }
.p-seg.fill { width: 100%; }
.p-seg.fill .sb { flex: 1 1 0px; height: 92px; line-height: 92px; padding: 0px 4px; font-size: 28px; letter-spacing: 0.5px; }

/* ---- toggle ---- */
.p-tog {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 76px;
    padding: 0px 26px 0px 8px;
    border-radius: 40px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.2);
    background-color: rgba(255, 255, 255, 0.05);
}
.p-tog .tr { position: relative; width: 112px; height: 60px; border-radius: 30px; background-color: rgba(255, 255, 255, 0.2); }
.p-tog .kn { position: absolute; left: 6px; top: 6px; width: 48px; height: 48px; border-radius: 24px; background-color: rgb(204, 204, 204); }
.p-tog .tt { margin-left: 20px; min-width: 52px; font-size: 27px; font-weight: 600; letter-spacing: 1.35px; text-transform: uppercase; color: rgba(255, 255, 255, 0.6); }
.p-tog.on .tr { background-color: rgb(29, 93, 226); }
.p-tog.on .kn { left: 58px; background-color: rgb(255, 255, 255); }
.p-tog.on .tt { color: rgb(255, 255, 255); }
.p-tog.hov { border-color: rgba(255, 255, 255, 0.6); background-color: rgba(255, 255, 255, 0.1); }

/* ---- slider ---- */
.p-sl { display: flex; flex-direction: row; align-items: center; width: 100%; }
.p-sl .trk { position: relative; flex: 1 1 0px; height: 76px; min-width: 200px; }
.p-sl .rail { position: absolute; left: 0px; right: 0px; top: 33px; height: 10px; border-radius: 5px; background-color: rgba(255, 255, 255, 0.2); overflow: hidden; }
.p-sl .fill { position: absolute; left: 0px; top: 0px; bottom: 0px; background-color: rgb(29, 93, 226); }
.p-sl .notch { position: absolute; top: 20px; width: 4px; height: 36px; margin-left: -2px; border-radius: 2px; background-color: rgba(255, 255, 255, 0.45); }
.p-sl .knob { position: absolute; top: 16px; width: 44px; height: 44px; margin-left: -22px; border-radius: 22px; background-color: rgb(204, 204, 204); border-width: 4px; border-color: rgb(10, 10, 11); }
.p-sl .trk.hov .knob, .p-sl .trk.drag .knob { background-color: rgb(255, 255, 255); border-color: rgba(255, 255, 255, 0.35); }
.p-sl .val { margin-left: 26px; width: 150px; font-size: 30px; font-weight: 600; line-height: 1; color: rgb(255, 255, 255); white-space: nowrap; }

/* ---- stepper ---- */
.p-stepw { display: flex; flex-direction: row; align-items: center; }
.p-step {
    display: flex;
    flex-direction: row;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 20px;
    background-color: rgba(255, 255, 255, 0.05);
}
.p-step .sbt { width: 92px; height: 80px; font-size: 44px; font-weight: 500; line-height: 80px; text-align: center; color: rgb(255, 255, 255); border-radius: 18px; }
.p-step .sbt.hov { background-color: rgba(255, 255, 255, 0.1); }
.p-step .sbt.off { color: rgba(255, 255, 255, 0.25); }
.p-step .out {
    min-width: 190px;
    padding: 0px 12px;
    font-size: 32px;
    font-weight: 600;
    line-height: 80px;
    text-align: center;
    white-space: nowrap;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: rgba(255, 255, 255, 0.1);
}
.p-step.fill { width: 100%; }
.p-step.fill .sbt { width: 108px; height: 104px; line-height: 104px; }
.p-step.fill .out { flex: 1 1 0px; min-width: 0px; font-size: 36px; line-height: 104px; }
.p-extra { margin-left: 22px; font-size: 26px; font-weight: 500; color: rgb(204, 204, 204); white-space: nowrap; }

/* ---- read-only info ---- */
.p-info { display: flex; flex-direction: row; align-items: center; }
.p-info .iv {
    font-size: 34px;
    font-weight: 600;
    line-height: 1;
    padding: 20px 22px;
    border-radius: 16px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.2);
    background-color: rgba(255, 255, 255, 0.03);
    color: rgb(255, 255, 255);
    white-space: nowrap;
}
.p-info .ic { margin-left: 22px; font-size: 26px; line-height: 1.3; color: rgb(204, 204, 204); width: 520px; }

/* ---- buttons ---- */
.p-btn {
    position: relative;
    height: 76px;
    padding: 0px 32px;
    border-radius: 18px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.3);
    background-color: rgba(255, 255, 255, 0.05);
    font-size: 27px;
    font-weight: 600;
    letter-spacing: 1.35px;
    text-transform: uppercase;
    line-height: 72px;
    text-align: center;
    white-space: nowrap;
    color: rgb(242, 242, 242);
}
.p-btn.hov { border-color: rgba(255, 255, 255, 0.6); background-color: rgba(255, 255, 255, 0.1); }
.p-btn.primary { background-color: rgb(29, 93, 226); border-color: rgb(29, 93, 226); color: rgb(255, 255, 255); }
.p-btn.primary.hov { background-color: rgb(52, 114, 240); border-color: rgb(167, 191, 241); }
.p-btn.armed { border-color: rgb(255, 53, 31); background-color: rgba(255, 53, 31, 0.2); color: rgb(255, 149, 138); }
.p-btn.big { height: 92px; line-height: 88px; padding: 0px 40px; font-size: 30px; }
.p-btn.small { height: 76px; }
.p-x { position: relative; width: 80px; height: 80px; border-radius: 18px; border-width: 2px; border-color: rgba(255, 255, 255, 0.3); background-color: rgba(255, 255, 255, 0.05); margin-left: 20px; }
.p-x.hov { border-color: rgba(255, 255, 255, 0.6); background-color: rgba(255, 255, 255, 0.1); }
.p-x .xl { position: absolute; left: 20px; top: 36px; width: 36px; height: 4px; border-radius: 2px; background-color: rgb(255, 255, 255); }
.p-x .xa { transform: rotate(45deg); }
.p-x .xb { transform: rotate(-45deg); }

/* ---- controller hint bar ---- */
.p-hints { display: flex; flex-direction: row; align-items: center; }
.p-hint { display: flex; flex-direction: row; align-items: center; margin-left: 34px; }
.p-hint .g { font-size: 46px; color: rgb(255, 255, 255); margin-right: 4px; }
.p-hint .ht { margin-left: 8px; font-size: 27px; font-weight: 500; line-height: 1; color: rgb(204, 204, 204); white-space: nowrap; }

/* ---- controller map ---- */
.p-map { display: flex; flex-direction: row; width: 100%; }
.p-map .mc { flex: 1 1 0px; }
.me { display: flex; flex-direction: row; align-items: center; height: 54px; }
.me .g { width: 60px; font-size: 46px; color: rgb(255, 255, 255); text-align: center; }
.me .g.two { width: 92px; font-size: 40px; }
.me .mt { margin-left: 14px; font-size: 26px; color: rgb(204, 204, 204); white-space: nowrap; }
.me.wide { margin-top: 6px; }

/* ---- C: the quick menu ---- */
.vc-win {
    position: absolute;
    left: 160px;
    top: 106px;
    width: 1600px;
    height: 868px;
    display: flex;
    flex-direction: column;
    background-color: rgba(10, 10, 11, 0.95);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 28px;
    overflow: hidden;
}
.vc-top {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 112px;
    padding: 0px 22px 0px 44px;
    border-bottom-width: 2px;
    border-color: rgba(255, 255, 255, 0.1);
}
.vc-top .chip { margin-left: 24px; }
.vc-grid { flex: 1 1 0px; display: flex; flex-direction: column; padding: 32px 40px; }
.vc-row { flex: 1 1 0px; display: flex; flex-direction: row; }
.vc-row.r2 { margin-top: 24px; }
.vc-tile {
    position: relative;
    flex: 1 1 0px;
    display: flex;
    flex-direction: column;
    padding: 24px 28px 24px 28px;
    margin-left: 24px;
    border-radius: 24px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(255, 255, 255, 0.05);
}
.vc-tile:first-child { margin-left: 0px; }
.vc-tile .ring { border-radius: 24px; }
.vc-tt { display: flex; flex-direction: row; align-items: center; justify-content: space-between; height: 44px; }
.vc-tt .p-label { font-size: 31px; white-space: nowrap; }
.vc-val { font-size: 30px; font-weight: 600; line-height: 1; color: rgb(167, 191, 241); white-space: nowrap; margin-left: 16px; }
.vc-ctl { margin-top: 18px; }
.vc-sub { margin-top: 14px; font-size: 26px; line-height: 1.3; color: rgb(204, 204, 204); white-space: nowrap; }
.vc-sub.why { color: rgb(255, 215, 148); }
.vc-tile.dis .vc-ctl { opacity: 0.35; }
.vc-foot {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 124px;
    padding: 0px 40px;
    border-top-width: 2px;
    border-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(0, 0, 0, 0.35);
}
.vc-top .p-btn { margin-left: 20px; }

/* ---- B: the full panel ---- */
.vb-win {
    position: absolute;
    left: 56px;
    top: 40px;
    width: 1808px;
    height: 1000px;
    display: flex;
    flex-direction: column;
    background-color: rgba(10, 10, 11, 0.95);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    overflow: hidden;
}
.vb-top {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 112px;
    padding: 0px 22px 0px 44px;
    border-bottom-width: 2px;
    border-color: rgba(255, 255, 255, 0.1);
}
.vb-top .chip { margin-left: 24px; }
.vb-body { height: 792px; display: flex; flex-direction: row; }
.vb-rail {
    width: 440px;
    display: flex;
    flex-direction: column;
    padding: 20px 18px;
    border-right-width: 2px;
    border-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(0, 0, 0, 0.22);
}
.bump { display: flex; flex-direction: row; align-items: center; height: 56px; padding: 0px 18px; }
.bump .g { font-size: 40px; color: rgba(255, 255, 255, 0.8); }
.bump .bt { margin-left: 12px; font-size: 26px; font-weight: 500; line-height: 1; color: rgba(255, 255, 255, 0.55); }
.vb-tab {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    min-height: 96px;
    margin-top: 6px;
    padding: 14px 26px 14px 34px;
    border-radius: 16px;
    color: rgba(255, 255, 255, 0.6);
}
.vb-tab .tl { font-size: 32px; font-weight: 600; line-height: 1.15; }
.vb-tab.hov { background-color: rgba(255, 255, 255, 0.05); color: rgba(255, 255, 255, 0.9); }
.vb-tab.on { background-color: rgba(255, 255, 255, 0.1); color: rgb(255, 255, 255); }
.vb-tab .mark { position: absolute; left: 10px; top: 22px; bottom: 22px; width: 6px; border-radius: 3px; }
.vb-tab.on .mark { background-color: rgb(247, 158, 8); }
.vb-main { flex: 1 1 0px; height: 792px; }
.vb-head {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 116px;
    padding: 0px 36px 0px 48px;
    border-bottom-width: 2px;
    border-color: rgba(255, 255, 255, 0.1);
}
.vb-list { position: relative; height: 676px; overflow: hidden; }
.vb-in { padding: 12px 22px 24px 22px; }
.vb-row {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    min-height: 116px;
    padding: 14px 22px;
    margin-top: 2px;
    border-width: 4px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 18px;
}
.vb-row.wide { flex-direction: column; align-items: flex-start; }
.vb-row.wide .vb-text { flex: none; width: 100%; }
.vb-row.wide .vb-ctl { width: 100%; margin-left: 0px; margin-top: 18px; flex-direction: column; align-items: flex-start; }
.vb-text { flex: 1 1 0px; }
.vb-ctl { width: 760px; margin-left: 36px; display: flex; flex-direction: row; align-items: center; }
.vb-row.dis .vb-ctl { opacity: 0.35; }
.vb-foot {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 92px;
    padding: 0px 44px 0px 10px;
    border-top-width: 2px;
    border-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(0, 0, 0, 0.35);
}

/* ---- toast ---- */
.toast { position: absolute; left: 0px; right: 0px; bottom: 150px; display: flex; flex-direction: row; justify-content: center; }
.toast .tw {
    padding: 24px 36px;
    border-radius: 18px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.6);
    background-color: rgb(10, 10, 11);
    font-size: 30px;
    font-weight: 600;
    line-height: 1.2;
    color: rgb(255, 255, 255);
    white-space: nowrap;
}
